# ──────────────────────────────────────────────
# DocuGuard AI Lite — Configuración de entorno
# Copiá este archivo como .env y completá los valores
# ──────────────────────────────────────────────

# API Key de Anthropic (Claude) — OBLIGATORIA
# Obtenela en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# URL de la base de datos SQLite
# Por defecto: archivo local docuguard.db
DATABASE_URL=sqlite+aiosqlite:///./docuguard.db

# Ruta donde ChromaDB persiste los índices vectoriales
# Se crea automáticamente al correr scripts/seed_corpus.py
CHROMA_DB_PATH=./chroma_db

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tamaño máximo de archivo subido (en MB)
MAX_FILE_SIZE_MB=50

# ─── Ollama (local, gratis) ───
# Proveedor por defecto del pipeline. Sin API key, corre 100% local.
# Instalación: https://ollama.com/
# Para cambiar a Anthropic: LLM_PROVIDER=anthropic
LLM_PROVIDER=ollama

# URL base de la API de Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de Ollama a usar
# Recomendado: "llama3.2:3b" (rápido, 3B params)
# Para mejor precisión en extracción de JSON: "qwen2.5:7b" (más lento pero más confiable)
OLLAMA_MODEL=llama3.2:3b

# ─── Google Gemini ───
# API Key de Google AI Studio.
# Obtenela en https://aistudio.google.com/apikey
# Para activar: LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Límite diario de requests
# Poner 0 para deshabilitar el límite.
DAILY_REQUEST_LIMIT=150

# Cooldown global de 60s entre uploads
# Poner 0 para deshabilitar.
UPLOAD_COOLDOWN_SECONDS=60
